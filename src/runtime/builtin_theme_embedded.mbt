  result["partials/sidebar.html"] = BUILTIN_THEME_PARTIAL_SIDEBAR_HTML
  result
}

///|
const BUILTIN_THEME_ASSET_MOONINK_DEFAULT_CSS : String =
  ":root {\n  color-scheme: light;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  font-family: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n  background:\n    radial-gradient(circle at top left, rgba(217, 181, 156, 0.35), transparent 32rem),\n    linear-gradient(180deg, rgba(251, 247, 240, 0.72), rgba(243, 237, 226, 0.92)),\n    var(--moonink-color-bg, #f3ede2);\n  color: var(--moonink-color-fg, #231b15);\n  line-height: 1.68;\n}\n\na {\n  color: inherit;\n  text-decoration-thickness: 0.08em;\n  text-underline-offset: 0.18em;\n}\n\nimg {\n  display: block;\n  max-width: 100%;\n}\n\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 30;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1rem 1.6rem;\n  backdrop-filter: blur(16px);\n  background: rgba(251, 247, 240, 0.82);\n  border-bottom: 1px solid var(--moonink-border-muted, #d7c6b4);\n}\n\n.site-brand {\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n  font-size: 1.15rem;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-decoration: none;\n}\n\n.site-header-meta {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  font-size: 0.82rem;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.site-header-links {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin-left: auto;\n  margin-right: 1rem;\n  font-size: 0.92rem;\n}\n\n.site-header-links a {\n  text-decoration: none;\n}\n\n.site-chip {\n  padding: 0.22rem 0.72rem;\n  border-radius: 999px;\n  background: rgba(141, 76, 47, 0.1);\n  border: 1px solid rgba(141, 76, 47, 0.18);\n}\n\n.site-shell {\n  display: grid;\n  grid-template-columns: minmax(14rem, var(--moonink-sidebar-width, 17rem)) minmax(0, 1fr);\n  align-items: start;\n}\n\n.site-nav {\n  position: sticky;\n  top: 4.3rem;\n  padding: 2rem 1.35rem 2rem 1.6rem;\n  min-height: calc(100vh - 4.3rem);\n  border-right: 1px solid rgba(141, 76, 47, 0.08);\n}\n\n.site-nav-label {\n  margin: 0 0 0.9rem;\n  font-size: 0.76rem;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.site-nav nav ul {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.site-nav nav ul ul {\n  margin-left: 0.85rem;\n  padding-left: 0.85rem;\n  border-left: 1px solid rgba(141, 76, 47, 0.12);\n}\n\n.site-nav nav li {\n  margin: 0.16rem 0;\n}\n\n.site-nav nav a {\n  display: inline-flex;\n  padding: 0.18rem 0;\n  text-decoration: none;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.site-nav nav li[data-active=\"true\"] > a,\n.site-nav nav li[data-ancestor=\"true\"] > a {\n  color: var(--moonink-color-fg, #231b15);\n}\n\n.content-shell {\n  padding: 2rem 2.2rem 4rem;\n}\n\n.content-shell-inner {\n  max-width: 58rem;\n}\n\n.content-header {\n  margin-bottom: 1.5rem;\n}\n\n.content-kind-label,\n.section-kicker,\n.article-meta-label {\n  margin: 0;\n  font-size: 0.74rem;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.content-title {\n  margin: 0.2rem 0 0.75rem;\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n  font-size: clamp(2.4rem, 5vw, 4.5rem);\n  line-height: 1.02;\n  letter-spacing: -0.03em;\n}\n\n.content-context {\n  color: var(--moonink-text-muted, #655648);\n}\n\n.content-context nav {\n  font-size: 0.95rem;\n}\n\nmain {\n  max-width: 52rem;\n}\n\n.article-page {\n  display: grid;\n  gap: 2rem;\n}\n\n.article-hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 1.6rem;\n  padding: 2rem;\n  border-radius: var(--moonink-radius-card, 1.35rem);\n  background: linear-gradient(160deg, rgba(251, 247, 240, 0.92), rgba(236, 223, 207, 0.7));\n  box-shadow: var(--moonink-shadow-card, 0 22px 60px rgba(61, 38, 18, 0.12));\n}\n\n.article-hero-copy {\n  display: grid;\n  gap: 1rem;\n}\n\n.article-eyebrow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n}\n\n.article-eyebrow-pill {\n  padding: 0.3rem 0.78rem;\n  border-radius: 999px;\n  border: 1px solid rgba(141, 76, 47, 0.16);\n  background: rgba(251, 247, 240, 0.68);\n  font-size: 0.78rem;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.article-summary {\n  max-width: 40rem;\n  margin: 0;\n  font-size: 1.12rem;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.article-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.7rem;\n}\n\n.article-meta-item {\n  padding: 0.4rem 0.75rem;\n  border-radius: 999px;\n  background: rgba(35, 27, 21, 0.055);\n  font-size: 0.88rem;\n}\n\n.tag-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.tag-list li {\n  padding: 0.3rem 0.75rem;\n  border-radius: 999px;\n  background: rgba(141, 76, 47, 0.12);\n  color: var(--moonink-color-accent, #8d4c2f);\n  font-size: 0.86rem;\n}\n\n.article-cover {\n  overflow: hidden;\n  border-radius: calc(var(--moonink-radius-card, 1.35rem) - 0.25rem);\n  min-height: 14rem;\n  background:\n    linear-gradient(135deg, rgba(141, 76, 47, 0.14), rgba(35, 27, 21, 0.04)),\n    var(--moonink-color-surface-alt, #ecdfcf);\n}\n\n.article-cover img {\n  width: 100%;\n  height: 100%;\n  min-height: 14rem;\n  object-fit: cover;\n}\n\n.article-grid {\n  display: grid;\n  grid-template-columns: minmax(0, var(--moonink-article-width, 48rem)) minmax(15rem, 19rem);\n  gap: 2rem;\n  align-items: start;\n}\n\n.article-main {\n  min-width: 0;\n}\n\n.article-toc {\n  position: sticky;\n  top: 5.6rem;\n  padding: 1.15rem 1.2rem;\n  border-radius: var(--moonink-radius-card, 1.35rem);\n  background: rgba(251, 247, 240, 0.7);\n  border: 1px solid rgba(141, 76, 47, 0.12);\n}\n\n.article-toc ol {\n  margin: 0.85rem 0 0;\n  padding-left: 1rem;\n}\n\n.article-toc li {\n  margin: 0.35rem 0;\n}\n\n.article-toc li[data-level=\"3\"] {\n  margin-left: 0.8rem;\n}\n\n.article-toc a {\n  text-decoration: none;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.article-body {\n  padding: 0.25rem 0 0;\n}\n\n.article-body > * {\n  max-width: none;\n}\n\n.article-body p,\n.article-body li {\n  font-size: 1.06rem;\n}\n\n.article-body h2,\n.article-body h3,\n.article-body h4 {\n  margin-top: 2.3rem;\n  scroll-margin-top: 5.6rem;\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n}\n\n.article-body blockquote {\n  margin: 1.8rem 0;\n  padding: 0.2rem 0 0.2rem 1rem;\n  border-left: 3px solid rgba(141, 76, 47, 0.3);\n  color: var(--moonink-text-muted, #655648);\n}\n\n.article-body code {\n  font-family: \"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace;\n  font-size: 0.92em;\n}\n\n.continuation-block,\n.author-card,\n.page-backlinks {\n  margin-top: 2.2rem;\n  padding: 1.35rem 1.35rem 1.5rem;\n  border-radius: var(--moonink-radius-card, 1.35rem);\n  background: rgba(251, 247, 240, 0.84);\n  border: 1px solid rgba(141, 76, 47, 0.12);\n}\n\n.section-heading {\n  display: grid;\n  gap: 0.22rem;\n  margin-bottom: 1rem;\n}\n\n.section-heading h2,\n.section-heading h3 {\n  margin: 0;\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n}\n\n.reading-lane {\n  display: grid;\n  gap: 0.9rem;\n}\n\n.relationship-stack {\n  display: grid;\n  gap: 1rem;\n}\n\n.relationship-group {\n  display: grid;\n  gap: 0.7rem;\n}\n\n.relationship-group-label {\n  margin: 0;\n  font-size: 0.78rem;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.nav-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.9rem;\n}\n\n.nav-card,\n.related-card,\n.backlink-card,\n.series-item {\n  display: grid;\n  gap: 0.35rem;\n  padding: 1rem 1rem 1.05rem;\n  border-radius: 1rem;\n  background: rgba(35, 27, 21, 0.035);\n}\n\n.nav-card-label,\n.series-item-label {\n  font-size: 0.74rem;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.nav-card a,\n.related-card a,\n.backlink-link,\n.series-item a {\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n  font-size: 1.08rem;\n  text-decoration: none;\n}\n\n.series-item-list,\n.related-list,\n.backlink-list {\n  display: grid;\n  gap: 0.8rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.series-meta,\n.related-reason,\n.backlink-meta,\n.backlink-series,\n.author-card-note {\n  margin: 0;\n  color: var(--moonink-text-muted, #655648);\n  font-size: 0.92rem;\n}\n\n.backlink-snippet,\n.author-card-copy {\n  margin: 0;\n}\n\n.author-card-title {\n  display: flex;\n  align-items: baseline;\n  gap: 0.65rem;\n  flex-wrap: wrap;\n}\n\n.author-card-title h3 {\n  margin: 0;\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n  font-size: 1.5rem;\n}\n\n.homepage-surface,\n.collection-surface,\n.archive-surface,\n.search-surface {\n  display: grid;\n  gap: 1.35rem;\n  margin: 0 0 1.35rem;\n}\n\n.homepage-surface-intro {\n  padding: 1.2rem 1.35rem;\n  border-radius: 1.2rem;\n  background: rgba(236, 223, 207, 0.55);\n  border: 1px solid rgba(141, 76, 47, 0.12);\n}\n\n.homepage-author-copy,\n.surface-card-summary,\n.surface-empty {\n  color: var(--moonink-text-muted, #655648);\n}\n\n.homepage-module,\n.archive-month {\n  display: grid;\n  gap: 1rem;\n}\n\n.surface-card-list {\n  display: grid;\n  gap: 1rem;\n}\n\n.surface-card-list-featured {\n  grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));\n}\n\n.surface-card-list-standard {\n  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));\n}\n\n.surface-card-list-compact {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.surface-card {\n  display: grid;\n  gap: 0.55rem;\n  padding: 1rem 1.1rem;\n  border-radius: 1.15rem;\n  background: rgba(251, 247, 240, 0.88);\n  border: 1px solid rgba(141, 76, 47, 0.12);\n  box-shadow: 0 14px 32px rgba(61, 38, 18, 0.08);\n}\n\n.surface-card-hero {\n  padding: 1.25rem 1.3rem;\n}\n\n.surface-card-compact {\n  box-shadow: none;\n}\n\n.surface-card h3,\n.surface-card p,\n.surface-card ul {\n  margin: 0;\n}\n\n.surface-card h3 {\n  font-size: 1.2rem;\n}\n\n.surface-card-flag,\n.surface-card-date,\n.surface-card-author,\n.surface-card-series {\n  font-size: 0.84rem;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.surface-card-tags,\n.author-profile-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.55rem;\n  padding: 0;\n  list-style: none;\n}\n\n.surface-card-tags a,\n.author-profile-links a {\n  text-decoration: none;\n}\n\n.surface-card-tags li,\n.author-profile-links li {\n  padding: 0.24rem 0.65rem;\n  border-radius: 999px;\n  background: rgba(141, 76, 47, 0.08);\n  border: 1px solid rgba(141, 76, 47, 0.12);\n  font-size: 0.82rem;\n}\n\n.search-input-shell {\n  display: grid;\n  gap: 0.55rem;\n}\n\n.search-input-shell input {\n  width: 100%;\n  padding: 0.82rem 1rem;\n  border-radius: 999px;\n  border: 1px solid rgba(141, 76, 47, 0.18);\n  background: rgba(251, 247, 240, 0.9);\n  color: inherit;\n  font: inherit;\n}\n\n.footer-spacer {\n  height: 1px;\n}\n\n.content-shell-page .content-title,\n.content-shell-index .content-title {\n  font-size: clamp(2rem, 4vw, 3.6rem);\n}\n\n.home-hero,\n.surface-links,\n.search-shell,\n.search-result,\n.surface-card,\n.home-module,\n.archive-list li {\n  border: 1px solid rgba(141, 76, 47, 0.12);\n}\n\n.home-hero {\n  display: grid;\n  gap: 1rem;\n  padding: 2rem;\n  border-radius: var(--moonink-radius-card, 1.35rem);\n  background: linear-gradient(160deg, rgba(251, 247, 240, 0.92), rgba(236, 223, 207, 0.7));\n  box-shadow: var(--moonink-shadow-card, 0 22px 60px rgba(61, 38, 18, 0.12));\n  margin-bottom: 1.75rem;\n}\n\n.home-hero-links,\n.surface-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n\n.home-hero-links a,\n.surface-links a {\n  display: inline-flex;\n  align-items: center;\n  padding: 0.45rem 0.85rem;\n  border-radius: 999px;\n  text-decoration: none;\n  background: rgba(251, 247, 240, 0.68);\n}\n\n.home-module-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 1.25rem;\n  margin-top: 2rem;\n}\n\n.home-module {\n  padding: 1.25rem;\n  border-radius: 1rem;\n  background: rgba(251, 247, 240, 0.82);\n}\n\n.home-card-grid,\n.home-card-list,\n.surface-card-grid,\n.surface-summary-list,\n.archive-list,\n.search-results {\n  list-style: none;\n  padding: 0;\n  margin: 1rem 0 0;\n}\n\n.home-card-grid,\n.surface-card-grid,\n.search-results {\n  display: grid;\n  gap: 0.9rem;\n}\n\n.home-card-list,\n.surface-summary-list,\n.archive-list {\n  display: grid;\n  gap: 0.75rem;\n}\n\n.home-card,\n.surface-card,\n.search-result,\n.archive-list li {\n  padding: 0.95rem 1rem;\n  border-radius: 0.95rem;\n  background: rgba(243, 237, 226, 0.9);\n}\n\n.home-card a,\n.surface-card a,\n.search-result-link {\n  text-decoration: none;\n}\n\n.home-card a,\n.search-result-link {\n  display: grid;\n  gap: 0.45rem;\n}\n\n.home-card-compact a {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n\n.home-card-date,\n.surface-card-meta,\n.search-result-meta,\n.surface-summary-count,\n.archive-date {\n  color: var(--moonink-text-muted, #655648);\n  font-size: 0.92rem;\n}\n\n.surface-card h3,\n.search-result-title {\n  margin: 0;\n  font-family: Baskerville, \"Palatino Linotype\", serif;\n  font-size: 1.25rem;\n}\n\n.surface-card p,\n.search-result-summary {\n  margin: 0.35rem 0 0;\n}\n\n.surface-summary-list li,\n.archive-list li {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 0.85rem;\n}\n\n.surface-summary-list a,\n.archive-list a {\n  text-decoration: none;\n}\n\n.search-shell {\n  display: grid;\n  gap: 1rem;\n  padding: 1.35rem;\n  border-radius: var(--moonink-radius-card, 1.35rem);\n  background: rgba(251, 247, 240, 0.82);\n}\n\n.search-label {\n  font-size: 0.82rem;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--moonink-text-muted, #655648);\n}\n\n.search-input {\n  width: 100%;\n  padding: 0.9rem 1rem;\n  border-radius: 0.95rem;\n  border: 1px solid rgba(141, 76, 47, 0.18);\n  background: rgba(255, 255, 255, 0.7);\n  color: var(--moonink-color-fg, #231b15);\n  font: inherit;\n}\n\n.search-status {\n  margin: 0;\n  color: var(--moonink-text-muted, #655648);\n}\n\n@media (min-width: 980px) {\n  .article-hero {\n    grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 20rem);\n    align-items: stretch;\n  }\n}\n\n@media (max-width: 1080px) {\n  .article-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .article-toc {\n    position: static;\n    order: -1;\n  }\n}\n\n@media (max-width: 900px) {\n  .site-shell {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .site-nav {\n    position: static;\n    min-height: auto;\n    padding: 1rem 1.4rem 0;\n    border-right: 0;\n  }\n\n  .content-shell {\n    padding: 1.3rem 1.1rem 3rem;\n  }\n\n  .home-module-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n@media (max-width: 680px) {\n  .site-header {\n    padding: 0.9rem 1rem;\n  }\n\n  .site-brand {\n    font-size: 1rem;\n  }\n\n  .content-title {\n    font-size: clamp(2rem, 11vw, 3rem);\n  }\n\n  .article-hero,\n  .continuation-block,\n  .author-card,\n  .page-backlinks,\n  .home-hero,\n  .home-module,\n  .search-shell {\n    padding: 1rem;\n  }\n\n  .nav-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n"

///|
const BUILTIN_THEME_ASSET_MOONINK_SEARCH_JS : String =
  "(function () {\n  const root = document.querySelector(\"[data-moonink-search-page]\");\n  if (!root) {\n    return;\n  }\n\n  const input = root.querySelector(\"#moonink-search-query\");\n  const status = root.querySelector(\"[data-search-status]\");\n  const results = root.querySelector(\"[data-moonink-search-results]\");\n  if (!(input instanceof HTMLInputElement) || !status || !results) {\n    return;\n  }\n\n  const searchIndexUrl = new URL(\"../search-index.json\", window.location.href).toString();\n\n  function tokenize(text) {\n    return (text || \"\").toLowerCase().match(/[a-z0-9]+/g) || [];\n  }\n\n  function containsToken(text, token) {\n    return (text || \"\").toLowerCase().includes(token);\n  }\n\n  function scoreItem(item, tokens) {\n    let total = 0;\n    for (const token of tokens) {\n      let tokenScore = 0;\n      if (containsToken(item.title, token)) {\n        tokenScore += 12;\n      }\n      if (containsToken(item.summary, token)) {\n        tokenScore += 8;\n      }\n      if (Array.isArray(item.tags) && item.tags.some((tag) => containsToken(tag, token))) {\n        tokenScore += 6;\n      }\n      if (containsToken(item.excerpt, token)) {\n        tokenScore += 3;\n      }\n      if (tokenScore === 0) {\n        return 0;\n      }\n      total += tokenScore;\n    }\n    return total;\n  }\n\n  function formatKind(kind) {\n    if (!kind) {\n      return \"Page\";\n    }\n    return kind.charAt(0).toUpperCase() + kind.slice(1);\n  }\n\n  function clearResults() {\n    results.textContent = \"\";\n  }\n\n  function node(tag, className, text) {\n    const element = document.createElement(tag);\n    if (className) {\n      element.className = className;\n    }\n    if (text) {\n      element.textContent = text;\n    }\n    return element;\n  }\n\n  function renderResults(items) {\n    clearResults();\n    for (const item of items) {\n      const li = node(\"li\", \"search-result\");\n      const link = node(\"a\", \"search-result-link\");\n      link.href = item.url;\n\n      const title = node(\"h2\", \"search-result-title\", item.title);\n      link.appendChild(title);\n\n      const metaParts = [formatKind(item.kind)];\n      if (item.date) {\n        metaParts.push(item.date);\n      }\n      if (Array.isArray(item.tags) && item.tags.length > 0) {\n        metaParts.push(item.tags.join(\", \"));\n      }\n      li.appendChild(link);\n      li.appendChild(node(\"p\", \"search-result-meta\", metaParts.join(\" · \")));\n\n      const description = item.summary || item.excerpt;\n      if (description) {\n        li.appendChild(node(\"p\", \"search-result-summary\", description));\n      }\n      results.appendChild(li);\n    }\n  }\n\n  function compareResults(left, right) {\n    if (left.score !== right.score) {\n      return right.score - left.score;\n    }\n    const leftDate = left.item.date || \"\";\n    const rightDate = right.item.date || \"\";\n    if (leftDate !== rightDate) {\n      return rightDate.localeCompare(leftDate);\n    }\n    return left.item.title.localeCompare(right.item.title);\n  }\n\n  function updateStatus(message) {\n    status.textContent = message;\n  }\n\n  let items = [];\n  let indexLoaded = false;\n\n  fetch(searchIndexUrl)\n    .then((response) => {\n      if (!response.ok) {\n        throw new Error(\"Failed to load search index\");\n      }\n      return response.json();\n    })\n    .then((document) => {\n      items = Array.isArray(document.items) ? document.items : [];\n      indexLoaded = true;\n      updateStatus(\"Type to search the generated index.\");\n    })\n    .catch(() => {\n      updateStatus(\"Search index could not be loaded.\");\n    });\n\n  function runSearch() {\n    if (!indexLoaded) {\n      updateStatus(\"Loading search index...\");\n      return;\n    }\n    const query = input.value.trim();\n    const tokens = tokenize(query);\n    if (tokens.length === 0) {\n      clearResults();\n      updateStatus(\"Type to search the generated index.\");\n      return;\n    }\n\n    const matches = items\n      .map((item) => ({ item, score: scoreItem(item, tokens) }))\n      .filter((entry) => entry.score > 0)\n      .sort(compareResults)\n      .slice(0, 24);\n\n    if (matches.length === 0) {\n      clearResults();\n      updateStatus(\"No results matched that query.\");\n      return;\n    }\n\n    renderResults(matches.map((entry) => entry.item));\n    updateStatus(matches.length + \" result\" + (matches.length === 1 ? \"\" : \"s\") + \" found.\");\n  }\n\n  input.addEventListener(\"input\", runSearch);\n})();\n"

///|
pub fn built_in_theme_asset_file_sources() -> Map[String, String] {
  let result : Map[String, String] = {}
  result["moonink-default.css"] = BUILTIN_THEME_ASSET_MOONINK_DEFAULT_CSS
  result["moonink-search.js"] = BUILTIN_THEME_ASSET_MOONINK_SEARCH_JS
  result
}

///|
pub fn built_in_theme_asset_source(relative_path : String) -> String? {
  built_in_theme_asset_file_sources().get(relative_path)
}

///|
pub fn embedded_builtin_theme_layout_source() -> String {
  built_in_theme_legacy_layout_source()
}

///|
pub fn embedded_builtin_theme_manifest_source() -> String {
  built_in_theme_manifest_source()
}

///|
pub fn embedded_builtin_theme_layout_file_sources() -> Map[String, String] {
  built_in_theme_layout_file_sources()
}

///|
pub fn embedded_builtin_theme_partial_sources() -> Map[String, String] {
  built_in_theme_partial_file_sources()
}

