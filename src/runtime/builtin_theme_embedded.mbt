const BUILTIN_THEME_LAYOUT_SEARCH_HTML : String =
  "<!doctype html>\n<html data-theme-v2=\"default\" data-layout-kind=\"{{ page.layout }}\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>{{ page.title }}</title>\n    <link rel=\"stylesheet\" href=\"{{ site.theme_asset_root }}moonink-default.css\">\n    <link rel=\"stylesheet\" href=\"{{ site.theme_asset_root }}theme-vars.css\">\n    {{ slots.head }}\n  </head>\n  <body class=\"{{ page.body_class }}\" data-kind=\"{{ page.kind }}\" data-url=\"{{ page.url_path }}\" data-theme=\"{{ site.theme_name }}\">\n    {% include \"header\" %}\n    <div class=\"site-shell\" data-content-layout=\"{{ page.layout }}\">\n      {% include \"sidebar\" %}\n      <div class=\"content-shell content-shell-search\">\n        <div class=\"content-shell-inner\">\n          <header class=\"content-header content-header-search\" data-content-layout=\"{{ page.layout }}\">\n            <p class=\"content-kind-label\">Search</p>\n            <h1 class=\"content-title\">{{ page.title }}</h1>\n            {% if page.summary %}<p class=\"article-summary\">{{ page.summary }}</p>{% endif %}\n          </header>\n          <main class=\"search-page-body\" data-source=\"{{ page.source_path }}\">{{ page.body_html }}</main>\n        </div>\n      </div>\n    </div>\n    {{ slots.scripts }}\n  </body>\n</html>\n"

///|
pub fn built_in_theme_layout_file_sources() -> Map[String, String] {
  let result : Map[String, String] = {}
  result["layouts/archive.html"] = BUILTIN_THEME_LAYOUT_ARCHIVE_HTML
  result["layouts/article.html"] = BUILTIN_THEME_LAYOUT_ARTICLE_HTML
  result["layouts/collection.html"] = BUILTIN_THEME_LAYOUT_COLLECTION_HTML
  result["layouts/index.html"] = BUILTIN_THEME_LAYOUT_INDEX_HTML
  result["layouts/page.html"] = BUILTIN_THEME_LAYOUT_PAGE_HTML
  result["layouts/search.html"] = BUILTIN_THEME_LAYOUT_SEARCH_HTML
  result
}

