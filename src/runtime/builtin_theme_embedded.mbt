const BUILTIN_THEME_MANIFEST_SOURCE : String =
  "{\n  \"name\": \"default\",\n  \"layouts\": {\n    \"index\": \"layouts/index.html\",\n    \"page\": \"layouts/page.html\",\n    \"article\": \"layouts/article.html\",\n    \"search\": \"layouts/search.html\",\n    \"collection\": \"layouts/collection.html\",\n    \"archive\": \"layouts/archive.html\"\n  },\n  \"tokens\": [\n    { \"name\": \"color.bg\", \"default\": \"#f3ede2\" },\n    { \"name\": \"color.fg\", \"default\": \"#231b15\" },\n    { \"name\": \"color.surface\", \"default\": \"#fbf7f0\" },\n    { \"name\": \"color.surface.alt\", \"default\": \"#ecdfcf\" },\n    { \"name\": \"color.accent\", \"default\": \"#8d4c2f\" },\n    { \"name\": \"color.accent.soft\", \"default\": \"#d9b59c\" },\n    { \"name\": \"sidebar.width\", \"default\": \"17rem\" },\n    { \"name\": \"article.width\", \"default\": \"48rem\" },\n    { \"name\": \"border.muted\", \"default\": \"#d7c6b4\" },\n    { \"name\": \"text.muted\", \"default\": \"#655648\" },\n    { \"name\": \"radius.card\", \"default\": \"1.35rem\" },\n    { \"name\": \"shadow.card\", \"default\": \"0 22px 60px rgba(61, 38, 18, 0.12)\" }\n  ],\n  \"page_overrides\": [\"layout\"],\n  \"slots\": [\"head\", \"scripts\"]\n}\n"

///|
pub fn built_in_theme_manifest_source() -> String {
  BUILTIN_THEME_MANIFEST_SOURCE
}

///|
const BUILTIN_THEME_LEGACY_LAYOUT_SOURCE : String =
  "<!doctype html>\n<html data-theme=\"default\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>{{ page_title }}</title>\n    <link rel=\"stylesheet\" href=\"{{ theme_asset_root }}moonink-default.css\">\n  </head>\n  <body class=\"{{ page_body_class }}\" data-kind=\"{{ content_kind }}\" data-url=\"{{ url_path }}\" data-theme=\"{{ theme_name }}\">\n    <header class=\"site-header\">\n      <a href=\"{{ site_url }}\">{{ site_name }}</a>\n    </header>\n    <div class=\"site-shell\" data-content-layout=\"{{ content_kind }}\">\n      <aside class=\"site-nav\">{{ navigation_html }}</aside>\n      <div class=\"content-shell\">\n        <header class=\"content-header\" data-content-layout=\"{{ content_kind }}\">\n          <p class=\"content-kind-label\">{{ content_kind }}</p>\n          <h1 class=\"content-title\">{{ page_header_title }}</h1>\n          <div class=\"content-context\" data-section-title=\"{{ current_section_title }}\" data-section-url=\"{{ current_section_url }}\">{{ page_header_html }}</div>\n        </header>\n        <main data-source=\"{{ source_path }}\">{{ body_html }}</main>\n        {{ backlinks_html }}\n      </div>\n    </div>\n  </body>\n</html>\n"

///|
pub fn built_in_theme_legacy_layout_source() -> String {
  BUILTIN_THEME_LEGACY_LAYOUT_SOURCE
}

///|
const BUILTIN_THEME_LAYOUT_ARCHIVE_HTML : String =
  "<!doctype html>\n<html data-theme-v2=\"default\" data-layout-kind=\"{{ page.layout }}\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>{{ page.title }}</title>\n    <link rel=\"stylesheet\" href=\"{{ site.theme_asset_root }}moonink-default.css\">\n    <link rel=\"stylesheet\" href=\"{{ site.theme_asset_root }}theme-vars.css\">\n    {{ slots.head }}\n  </head>\n  <body class=\"{{ page.body_class }}\" data-kind=\"{{ page.kind }}\" data-url=\"{{ page.url_path }}\" data-theme=\"{{ site.theme_name }}\">\n    {% include \"header\" %}\n    <div class=\"site-shell\" data-content-layout=\"{{ page.layout }}\">\n      {% include \"sidebar\" %}\n      <div class=\"content-shell content-shell-archive\">\n        <div class=\"content-shell-inner\">\n          <header class=\"content-header content-header-archive\" data-content-layout=\"{{ page.layout }}\">\n            <p class=\"content-kind-label\">Archive</p>\n            <h1 class=\"content-title\">{{ page.title }}</h1>\n            {% if page.summary %}<p class=\"article-summary\">{{ page.summary }}</p>{% endif %}\n            <div class=\"surface-links\">\n              <a href=\"{{ site.search_url }}\">Search</a>\n              <a href=\"{{ site.tags_url }}\">Tags</a>\n              <a href=\"{{ site.series_url }}\">Series</a>\n            </div>\n          </header>\n          <main class=\"surface-body\" data-source=\"{{ page.source_path }}\">{{ page.body_html }}</main>\n        </div>\n      </div>\n    </div>\n    {{ slots.scripts }}\n  </body>\n</html>\n"

///|
const BUILTIN_THEME_LAYOUT_ARTICLE_HTML : String =
  "<!doctype html>\n<html data-theme-v2=\"default\" data-layout-kind=\"{{ page.kind }}\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>{{ page.title }}</title>\n    <link rel=\"stylesheet\" href=\"{{ site.theme_asset_root }}moonink-default.css\">\n    <link rel=\"stylesheet\" href=\"{{ site.theme_asset_root }}theme-vars.css\">\n    {{ slots.head }}\n  </head>\n  <body class=\"{{ page.body_class }}\" data-kind=\"{{ page.kind }}\" data-url=\"{{ page.url_path }}\" data-theme=\"{{ site.theme_name }}\">\n    {% include \"header\" %}\n    <div class=\"site-shell\" data-content-layout=\"{{ page.kind }}\">\n      {% include \"sidebar\" %}\n      <div class=\"content-shell\">\n        <article class=\"article-page\">\n          <header class=\"article-hero\">\n            <div class=\"article-hero-copy\">\n              <div class=\"article-eyebrow\">\n                {% if page.column %}<span class=\"article-eyebrow-pill\">{{ page.column }}</span>{% endif %}\n                {% if page.series %}<span class=\"article-eyebrow-pill\">{{ page.series }}</span>{% endif %}\n              </div>\n              <div class=\"section-heading\">\n                <p class=\"section-kicker\">Article</p>\n                <h1 class=\"content-title\">{{ page.title }}</h1>\n              </div>\n              {% if page.summary %}<p class=\"article-summary\">{{ page.summary }}</p>{% endif %}\n              <div class=\"article-meta\">\n                {% if page.date %}<span class=\"article-meta-item\">{{ page.date }}</span>{% endif %}\n                {% if page.updated %}<span class=\"article-meta-item\">Updated {{ page.updated }}</span>{% endif %}\n                <span class=\"article-meta-item\">{{ page.reading_time_label }}</span>\n              </div>\n              {% if page.tags %}<ul class=\"tag-list\">{% for tag in page.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}\n            </div>\n            {% if page.cover_url %}<figure class=\"article-cover\"><img src=\"{{ page.cover_url }}\" alt=\"{{ page.title }}\"></figure>{% endif %}\n          </header>\n\n          <div class=\"article-grid\">\n            <div class=\"article-main\">\n              <div class=\"content-context\" data-section-title=\"{{ page.current_section_title }}\" data-section-url=\"{{ page.current_section_url }}\">{{ page.page_header_html }}</div>\n              <main class=\"article-body\" data-source=\"{{ page.source_path }}\">{{ page.body_html }}</main>\n\n              {% if page.series_nav.name %}\n              <section class=\"continuation-block\">\n                <div class=\"section-heading\">\n                  <p class=\"section-kicker\">Series</p>\n                  <h2>{{ page.series_nav.name }}</h2>\n                </div>\n                <div class=\"nav-grid\">\n                  {% if page.series_nav.previous.title %}<div class=\"nav-card\"><p class=\"nav-card-label\">Earlier</p><a href=\"{{ page.series_nav.previous.url }}\">{{ page.series_nav.previous.title }}</a></div>{% endif %}\n                  {% if page.series_nav.next.title %}<div class=\"nav-card\"><p class=\"nav-card-label\">Next</p><a href=\"{{ page.series_nav.next.url }}\">{{ page.series_nav.next.title }}</a></div>{% endif %}\n                </div>\n                {% if collections.series.count %}<ol class=\"series-item-list\">{% for item in collections.series.items %}<li class=\"series-item\"><p class=\"series-item-label\">Series item</p><a href=\"{{ item.url }}\">{{ item.title }}</a></li>{% endfor %}</ol>{% endif %}\n              </section>\n              {% endif %}\n\n              {% if page.has_neighbors %}\n              <section class=\"continuation-block\">\n                <div class=\"section-heading\">\n                  <p class=\"section-kicker\">Continue reading</p>\n                  <h2>Nearby articles</h2>\n                </div>\n                <div class=\"nav-grid\">\n                  {% if page.previous.title %}<div class=\"nav-card\"><p class=\"nav-card-label\">Previous</p><a href=\"{{ page.previous.url }}\">{{ page.previous.title }}</a></div>{% endif %}\n                  {% if page.next.title %}<div class=\"nav-card\"><p class=\"nav-card-label\">Next</p><a href=\"{{ page.next.url }}\">{{ page.next.title }}</a></div>{% endif %}\n                </div>\n              </section>\n              {% endif %}\n\n              {% if page.has_relationships %}\n              <section class=\"continuation-block\">\n                <div class=\"section-heading\">\n                  <p class=\"section-kicker\">Explore this thread</p>\n                  <h2>Follow the local knowledge path</h2>\n                </div>\n                <div class=\"relationship-stack\">\n                  {% if page.has_relationship_mentions %}\n                  <div class=\"relationship-group\">\n                    <p class=\"relationship-group-label\">Mentioned here</p>\n                    <ul class=\"related-list\">\n                      {% for item in collections.relationships.mentioned.items %}\n                      <li class=\"related-card\">\n                        <a href=\"{{ item.url }}\">{{ item.title }}</a>\n                        {% if item.snippet %}<p class=\"related-reason\">{{ item.snippet }}</p>{% endif %}\n                      </li>\n                      {% endfor %}\n                    </ul>\n                  </div>\n                  {% endif %}\n\n                  {% if page.has_relationship_backlinks %}\n                  <div class=\"relationship-group\">\n                    <p class=\"relationship-group-label\">Referenced by</p>\n                    <ul class=\"related-list\">\n                      {% for item in collections.relationships.backlinks.items %}\n                      <li class=\"related-card\">\n                        <a href=\"{{ item.url }}\">{{ item.title }}</a>\n                        {% if item.snippet %}<p class=\"related-reason\">{{ item.snippet }}</p>{% endif %}\n                      </li>\n                      {% endfor %}\n                    </ul>\n                  </div>\n                  {% endif %}\n\n                  {% if page.has_relationship_related %}\n                  <div class=\"relationship-group\">\n                    <p class=\"relationship-group-label\">Keep reading</p>\n                    <ul class=\"related-list\">\n                      {% for item in collections.relationships.related.items %}\n                      <li class=\"related-card\">\n                        <a href=\"{{ item.url }}\">{{ item.title }}</a>\n                        {% if item.reason %}<p class=\"related-reason\">{{ item.reason }}</p>{% endif %}\n                      </li>\n                      {% endfor %}\n                    </ul>\n                  </div>\n                  {% endif %}\n                </div>\n              </section>\n              {% endif %}\n\n              <section class=\"author-card\">\n                <div class=\"section-heading\">\n                  <p class=\"section-kicker\">Author</p>\n                  <div class=\"author-card-title\">\n                    <h3>{{ page.author_display }}</h3>\n                    {% if page.column %}<span class=\"site-chip\">{{ page.column }}</span>{% endif %}\n                  </div>\n                </div>\n                <p class=\"author-card-note\">Published from {{ site.name }}</p>\n                {% if site.author.bio %}<p class=\"author-card-copy\">{{ site.author.bio }}</p>{% endif %}\n                {% if site.author.homepage_text %}<p class=\"author-card-copy\">{{ site.author.homepage_text }}</p>{% endif %}\n                {% if site.author.links %}<ul class=\"author-profile-links\">{% for item in site.author.links.items %}<li><a href=\"{{ item.url }}\">{{ item.label }}</a></li>{% endfor %}</ul>{% endif %}\n              </section>\n            </div>\n\n            {% if page.has_toc %}\n            <aside class=\"article-toc\">\n              <p class=\"section-kicker\">On this page</p>\n              <ol>\n                {% for item in collections.toc.items %}\n                <li data-level=\"{{ item.level }}\"><a href=\"#{{ item.id }}\">{{ item.title }}</a></li>\n                {% endfor %}\n              </ol>\n            </aside>\n            {% endif %}\n          </div>\n        </article>\n      </div>\n    </div>\n    {{ slots.scripts }}\n  </body>\n</html>\n"

