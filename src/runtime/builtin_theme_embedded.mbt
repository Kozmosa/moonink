const BUILTIN_THEME_PARTIAL_HEADER_HTML : String =
  "<header class=\"site-header\">\n  <a class=\"site-brand\" href=\"{{ site.url }}\">{{ site.name }}</a>\n  <nav class=\"site-header-links\" aria-label=\"Primary\">\n    <a href=\"{{ site.search_url }}\">Search</a>\n    <a href=\"{{ site.archive_url }}\">Archive</a>\n  </nav>\n  <div class=\"site-header-meta\">\n    {% if page.column %}<span class=\"site-chip\">{{ page.column }}</span>{% endif %}\n    <span>{{ page.kind_label }}</span>\n  </div>\n</header>\n"

